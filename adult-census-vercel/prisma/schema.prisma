generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PredictionLog {
  id                 String   @id @default(uuid()) @db.Uuid
  input_json         Json
  predicted_label    String
  probability        Decimal  @db.Decimal(5, 4)
  class_probabilities Json?
  model_version      String
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  @@map("prediction_logs")
}

model ModelVersion {
  id              String    @id @default(uuid()) @db.Uuid
  version         String    @unique
  algorithm       String
  accuracy        Decimal?  @db.Decimal(5, 4)
  precision_score Decimal?  @db.Decimal(5, 4)
  recall_score    Decimal?  @db.Decimal(5, 4)
  f1_score        Decimal?  @db.Decimal(5, 4)
  model_path      String?
  metrics_json    Json?
  trained_at      DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@map("model_versions")
}

model DailyPredictionStat {
  id          String   @id @default(uuid()) @db.Uuid
  stat_date   DateTime @db.Date
  total_count Int      @default(0)
  count_le_50k Int     @default(0)
  count_gt_50k Int     @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([stat_date])
  @@map("daily_prediction_stats")
}
